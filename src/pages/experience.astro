---
import Base from "../layouts/Base.astro";

const items = [
  {
    when: "2024 to present",
    title: "BPH Laboratory Coordinator, EEPIS News and Network Team (ENT), PENS",
    body: "Joined as a photojournalist member, later trusted as BPH Laboratory Coordinator. Covers campus activities and documents student achievements for publication.",
  },
  {
    when: "2024 to 2025",
    title: "Member, Public Relations & Media Division, PKM Center, PENS",
    body: "Supported preparation and promotion of PKM competitions for PENS students, and managed media communication and content for organizational needs.",
  },
  {
    when: "2026",
    title: "UI/UX Designer & Graphic Designer, PENSFEST 2026 Volunteer Committee",
    body: "Designed visual materials for a major campus event, from concept through final asset production. (Featured as a project under design.)",
  },
];
---
<Base title="experience | Syauqy" current="experience">
  <section class="detail">
    <a class="back" href="/">← back to portfolio</a>
    <h1>experience</h1>
    <p class="prose muted" style="margin: 1rem 0 2rem">
      Organizations, extracurriculars, and volunteering show the human side
      behind the projects. This page focuses on character and contribution,
      rather than another skill category.
    </p>
    <div class="timeline">
      {items.map((i) => (
        <div class="item">
          <div class="when">{i.when}</div>
          <h3>{i.title}</h3>
          <p>{i.body}</p>
        </div>
      ))}
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactForm from "../components/ContactForm.astro";

const categories = [
  {
    id: "software",
    name: "software",
    blurb:
      "Programming and computer science work, including the UI/UX design behind each project.",
  },
  {
    id: "design",
    name: "design",
    blurb: "Graphic design and visual craft, from posters and identities to event materials.",
  },
  {
    id: "media",
    name: "media",
    blurb:
      "Photography and videography, done as paid freelance work.",
  },
] as const;

const skills = [
  {
    group: "design",
    items: ["Figma", "Wireframe", "Prototyping", "Handoff", "UI/UX Design", "Graphic Design"],
  },
  {
    group: "development",
    items: ["Laravel", "ReactJS", "ASP.NET", "Next.js", "Flutter", "HTML/CSS"],
  },
  {
    group: "tools & IDEs",
    items: ["VS Code", "Antigravity IDE (Google)", "Zed"],
  },
  {
    group: "creative",
    items: ["Photography", "Videography", "Video Editing", "Event Documentation"],
  },
  {
    group: "soft skills",
    items: ["Public Speaking", "Team Collaboration", "Leadership"],
  },
];
---
<Base title="Syauqy | portfolio" current="home">
  <section class="hero">
    <p class="term">visitor@recruiter:~$ whoami</p>
    <h1>
      Hi, I'm Syauqy, a <span style="color: var(--green-bright)">UI/UX
      designer</span> who codes<span class="blink">_</span>
    </h1>
    <p class="lede">
      I connect visual design with working software. I take projects from
      end-to-end Figma work to implementation with Laravel, React, and Next.js.
      This portfolio shows my role, process, and results across each project.
    </p>
    <div class="roles">
      <span class="tag soft">$ ui/ux design</span>
      <span class="tag">% frontend dev</span>
      <span class="tag warn">! creative media</span>
    </div>
    <div class="cta-row">
      <a class="btn solid" href="#software">view projects</a>
      <a class="btn" href="#contact">contact me</a>
    </div>
  </section>

  <section class="section" id="about">
    <div class="section-head">
      <span class="hash">#</span><h2>about</h2><span class="rule"></span>
    </div>
    <div class="prose">
      <p>
        I'm a UI/UX designer who codes. At PENS, Politeknik Elektronika Negeri
        Surabaya, I've worked across product design, event documentation, and
        web development, often at the same time. I enjoy work where design
        decisions connect directly to what gets built.
      </p>
      <p class="muted">
        Looking for roles and collaborations where the design and the code are
        part of one conversation.
      </p>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="section-head">
      <span class="hash">#</span><h2>skills</h2><span class="rule"></span>
    </div>
    <div class="skill-grid">
      {skills.map((s) => (
        <div class="panel skill-group">
          <h3 class="skill-name">{s.group}</h3>
          <div class="skill-tags">
            {s.items.map((i) => (
              <span class="tag">{i}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="education">
    <div class="section-head">
      <span class="hash">#</span><h2>education</h2><span class="rule"></span>
    </div>
    <div class="timeline">
      <div class="item">
        <div class="when">2024 to present</div>
        <h3>S.Tr. Informatics Engineering, Politeknik Elektronika Negeri Surabaya (PENS)</h3>
        <p>Software development, UI/UX design, and data analysis.</p>
      </div>
      <div class="item">
        <div class="when">2021 to 2024</div>
        <h3>SMA Muhammadiyah 10 GKB, Gresik</h3>
        <p>Video editor for podcasts, dakwah, and graduation teasers; lead photographer for student ID cards.</p>
      </div>
      <div class="item">
        <div class="when">2019 to 2021</div>
        <h3>SMP Muhammadiyah 12 GKB, Gresik</h3>
      </div>
      <div class="item">
        <div class="when">2012 to 2018</div>
        <h3>SD Muhammadiyah 1 GKB, Gresik</h3>
      </div>
    </div>
  </section>

  {categories.map((c) => (
    <section class="section" id={c.id}>
      <div class="section-head">
        <span class="hash">#</span><h2>{c.name}</h2><span class="rule"></span>
      </div>
      <p class="prose muted" style="margin-bottom: 1.25rem">{c.blurb}</p>
      <div class="grid">
        <ProjectCard category={c.id} />
      </div>
    </section>
  ))}

  <section class="section" id="experience">
    <div class="section-head">
      <span class="hash">#</span><h2>experience</h2><span class="rule"></span>
    </div>
    <div class="prose">
      <p class="muted">
        Organizations, extracurriculars, and event volunteering live on their
        own page. They show the human side behind the craft.
      </p>
      <a class="btn" href="/experience">open experience page →</a>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="section-head">
      <span class="hash">#</span><h2>contact</h2><span class="rule"></span>
    </div>
    <p class="prose muted" style="margin-bottom: 1.5rem">
      Want to talk about a project, a role, or a collaboration? Send a message
      and it will land in my inbox. You can also email me directly at
      <a href="mailto:syauqy.arrayyan@gmail.com">syauqy.arrayyan@gmail.com</a>.
    </p>
    <ContactForm />
  </section>
</Base>

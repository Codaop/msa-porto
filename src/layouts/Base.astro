---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import BootScreen from "../components/BootScreen.astro";

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = "Syauqy | UI/UX designer, frontend developer, and creative media creator. Explore software, design, and media projects with clear evidence.",
  current = "",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <BootScreen />
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <footer>
      <span class="green">~/</span> syauqy | built with astro, styled like kali
      <br />© {new Date().getFullYear()} · syauqy.arrayyan@gmail.com ·
      <span class="green">Gresik, East Java, ID</span>
    </footer>
  </body>
</html>
